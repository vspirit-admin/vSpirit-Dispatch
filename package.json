{
  "name": "vspirit-dispatch",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "NODE_ENV=test node --experimental-vm-modules --disable-warning=ExperimentalWarning ./node_modules/.bin/jest",
    "dev": "nodemon --watch src --watch .env --ext ts,js --exec \"node --import ./register-ts.js ./src/index.ts\"",
    "build": "tsc",
    "start": "node .",
    "lint": "eslint .",
    "update": "npm-check -u",
    "deploy.production": "npm run test && flyctl deploy -c ./fly/fly.production.toml",
    "deploy.prod": "npm run deploy.production",
    "deploy.staging": "npm run test && flyctl deploy -c ./fly/fly.staging.toml",
    "deploy.stage": "npm run deploy.staging"
  },
  "author": "GoldenXLence",
  "maintainers": [
    "Ryan Breaker"
  ],
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/vspirit-admin/vSpirit-Dispatch.git"
  },
  "engines": {
    "node": "^24"
  },
  "type": "module",
  "dependencies": {
    "@isaacs/ttlcache": "^1.4.1",
    "axios": "^1.13.2",
    "better-sqlite3": "^12.5.0",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "lodash": "^4.17.21",
    "node-cron": "^3.0.2",
    "node-filter-async": "^3.0.0",
    "qs": "^6.11.0",
    "redis": "^4.5.0",
    "reflect-metadata": "^0.1.13",
    "simple-oauth2": "^5.1.0",
    "tslog": "^3.3.4",
    "typeorm": "^0.3.12",
    "typeorm-naming-strategies": "^4.1.0",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/express": "4.17.13",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.14.184",
    "@types/node": "^18.14.0",
    "@types/node-cron": "^3.0.2",
    "@types/simple-oauth2": "^5.0.8",
    "@types/uuid": "8.3.4",
    "@typescript-eslint/eslint-plugin": "^8.50.1",
    "@typescript-eslint/parser": "^8.50.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^8.5.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.11",
    "prettier": "^2.7.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
